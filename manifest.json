{
  "manifest_version": 3,
  "name": "TeachAssist AI Recorder",
  "version": "0.2.8",
  "description": "TeachAssist AI meeting recorder skeleton for Google Meet and Microsoft Teams.",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabCapture",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TeachAssist AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/no-meeting/icon16.png",
      "32": "icons/no-meeting/icon32.png",
      "48": "icons/app/icon48.png",
      "128": "icons/app/icon128.png"
    }
  },

    "commands": {
      "toggle-recording": {
        "suggested_key": {
          "default": "Ctrl+Shift+F"
        },
        "description": "Start or stop recording"
      }
    },
    
  "icons": {
    "16": "icons/no-meeting/icon16.png",
    "32": "icons/no-meeting/icon32.png",
    "48": "icons/app/icon48.png",
    "128": "icons/app/icon128.png"
  }
  
}